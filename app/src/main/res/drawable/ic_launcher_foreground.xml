<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="1080"
    android:viewportHeight="1080">

    <!-- === LENS EXTERIOR BODY === -->

    <!-- Soft drop shadow under the lens -->
    <path
        android:fillColor="#000000"
        android:fillAlpha="0.15"
        android:pathData="M 540,255 A 295,295 0 1,0 540,845 A 295,295 0 1,0 540,255 Z" />

    <!-- Outer ring – dark brushed metal -->
    <path
        android:fillColor="#3A3A3C"
        android:pathData="M 540,250 A 290,290 0 1,0 540,830 A 290,290 0 1,0 540,250 Z" />

    <!-- Outer light bevel (top highlight) -->
